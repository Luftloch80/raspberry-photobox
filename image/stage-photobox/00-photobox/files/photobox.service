[Unit]
Description=Raspberry Photobox
After=network.target photobox-boot.service cups.service
Wants=photobox-boot.service

[Service]
User=__USER__
WorkingDirectory=/opt/photobox
EnvironmentFile=/opt/photobox/.env
ExecStart=/usr/bin/python3 app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
