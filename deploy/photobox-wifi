#!/bin/bash
# Photobox: zwischen eigenem Hotspot und normalem WLAN umschalten (läuft als root).
#
#   photobox-wifi hotspot   Hotspot einschalten
#   photobox-wifi client    mit einem bekannten WLAN verbinden; klappt das nicht,
#                           wird der Hotspot wieder eingeschaltet
#   photobox-wifi credentials        Name und Passwort des Hotspots ausgeben (2 Zeilen)
#   photobox-wifi set-password       neues Hotspot-Passwort von stdin setzen
#
# Die Photobox ruft das Skript per "sudo -n" auf (siehe /etc/sudoers.d/photobox-wifi).
set -u

CON=Photobox-Hotspot
IFACE=wlan0
LOG_TAG=photobox-wifi

STATUS_LOG=/run/photobox-wifi.log   # letzte Meldungen, für die Statusseite

log() {
  logger -t "$LOG_TAG" -- "$*"
  echo "$*"
  { echo "$(date '+%H:%M:%S') $*"; tail -n 19 "$STATUS_LOG" 2> /dev/null || true; } > "$STATUS_LOG.tmp" \
    && mv "$STATUS_LOG.tmp" "$STATUS_LOG" && chmod 644 "$STATUS_LOG"
}

# nmcli ausführen; Fehlermeldungen ins Systemprotokoll (journalctl -t photobox-wifi)
nm() {
  local out
  if out="$(nmcli "$@" 2>&1)"; then
    return 0
  fi
  log "nmcli $* fehlgeschlagen: $out"
  return 1
}

hotspot_up() {
  # PMF aus: mit PMF bricht der Hotspot auf dem Raspberry-Pi-WLAN-Chip (brcmfmac)
  # mit "Hotspot network creation took too long" ab
  if [ "$(nmcli -g 802-11-wireless-security.pmf connection show "$CON" 2> /dev/null)" != "disable" ]; then
    nmcli connection modify "$CON" 802-11-wireless-security.pmf disable 2> /dev/null || true
  fi
  nm --wait 30 connection up "$CON"
}

current_wifi() {
  nmcli -t -f DEVICE,STATE,CONNECTION device | awk -F: -v i="$IFACE" '$1==i && $2=="connected" {print $3}'
}

case "${1:-}" in
  hotspot)
    previous="$(current_wifi)"
    log "Schalte auf Hotspot (bisher: ${previous:-keine Verbindung})"
    rfkill unblock wifi 2> /dev/null || true
    if hotspot_up; then
      log "Hotspot aktiv: $(nmcli -g 802-11-wireless.ssid connection show "$CON")"
      exit 0
    fi
    # Hotspot klappt nicht: zurück ins vorherige WLAN, damit der Pi erreichbar bleibt
    if [ -n "$previous" ] && [ "$previous" != "$CON" ]; then
      log "Hotspot fehlgeschlagen – verbinde wieder mit '$previous'"
      nm --wait 30 connection up "$previous" ifname "$IFACE" || true
    fi
    exit 1
    ;;

  client)
    log "Schalte auf normales WLAN"
    nmcli connection down "$CON" > /dev/null 2>&1 || true
    rfkill unblock wifi 2> /dev/null || true
    nmcli device wifi rescan ifname "$IFACE" > /dev/null 2>&1 || true
    sleep 4
    visible="$(nmcli -t -f SSID device wifi list ifname "$IFACE" --rescan no 2> /dev/null)"

    # Bekannte WLAN-Verbindungen (ohne Hotspot), höchste Priorität zuerst
    while IFS=: read -r prio name; do
      [ -n "$name" ] || continue
      ssid="$(nmcli -g 802-11-wireless.ssid connection show "$name" 2> /dev/null)"
      mode="$(nmcli -g 802-11-wireless.mode connection show "$name" 2> /dev/null)"
      [ "$mode" = "ap" ] && continue
      if [ -n "$ssid" ] && ! grep -Fxq -- "$ssid" <<< "$visible"; then
        log "WLAN '$ssid' nicht in Reichweite"
        continue
      fi
      log "Verbinde mit '$name'"
      if nm --wait 30 connection up "$name" ifname "$IFACE"; then
        log "Verbunden mit '$name'"
        exit 0
      fi
    done < <(nmcli -t -f AUTOCONNECT-PRIORITY,NAME,TYPE connection show \
               | awk -F: -v hs="$CON" '$3=="802-11-wireless" && $2!=hs {print $1":"$2}' \
               | sort -t: -k1,1nr)

    log "Kein bekanntes WLAN erreichbar – schalte zurück auf Hotspot"
    hotspot_up
    exit 2
    ;;

  credentials)
    nmcli -g 802-11-wireless.ssid connection show "$CON" || exit 1
    nmcli -s -g 802-11-wireless-security.psk connection show "$CON"
    ;;

  set-password)
    IFS= read -r pw || true
    pw="${pw%$'\r'}"
    if [ ${#pw} -lt 8 ] || [ ${#pw} -gt 63 ] || [[ "$pw" =~ [^[:print:]] ]]; then
      echo "Das Passwort muss 8 bis 63 normale Zeichen haben." >&2
      exit 1
    fi
    if ! nm connection modify "$CON" wifi-sec.psk "$pw"; then
      echo "Passwort konnte nicht gesetzt werden." >&2
      exit 1
    fi
    # Beim Image steht das Passwort auch in photobox.txt (wird bei jedem Start übernommen)
    CONF=/boot/firmware/photobox.txt
    if [ -f "$CONF" ] && grep -q '^WLAN_PASSWORT=' "$CONF"; then
      PW="$pw" awk '{ if ($0 ~ /^WLAN_PASSWORT=/) { cr = ($0 ~ /\r$/) ? "\r" : ""; print "WLAN_PASSWORT=" ENVIRON["PW"] cr } else print }' \
        "$CONF" > "$CONF.tmp" && cat "$CONF.tmp" > "$CONF" && rm -f "$CONF.tmp"
    fi
    log "Hotspot-Passwort geändert"
    # Läuft der Hotspot gerade, neu starten, damit das Passwort gilt. Im Hintergrund,
    # damit die Photobox vorher noch antworten kann.
    if [ "$(current_wifi)" = "$CON" ]; then
      echo "restart"
      ( sleep 3; nm --wait 30 connection up "$CON" ) > /dev/null 2>&1 &
      disown
    fi
    ;;

  *)
    echo "Aufruf: $0 hotspot | client | credentials | set-password" >&2
    exit 1
    ;;
esac
