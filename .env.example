# CUPS-Druckername (leer = Standarddrucker). Namen anzeigen mit: lpstat -p
PHOTOBOX_PRINTER=

# Zusätzliche CUPS-Optionen (durch Leerzeichen getrennt), z. B. für Canon Selphy 10x15:
#   PHOTOBOX_PRINT_OPTIONS=fit-to-page media=Postcard
PHOTOBOX_PRINT_OPTIONS=fit-to-page

# Druckformat des Fotostreifens:
#   58mm  = ein Streifen auf 58-mm-Bondrucker-Rolle (Standard), 80mm = 80-mm-Rolle,
#   10x15 = Fotopapier 10×15 cm (siehe PHOTOBOX_STRIPS_PER_PAGE)
PHOTOBOX_PRINT_FORMAT=58mm

# Nur bei Bondruckern (58mm/80mm): Fotos für den Thermodruck aufbereiten (Graustufen, Kontrast,
# Gegenlicht-Ausgleich, Aufhellen, Schärfen). 0 = aus.
#   GAMMA < 1 macht heller (1 = unverändert, 0.5 = sehr hell), EQUALIZE 0…1 hebt dunkle Gesichter an
PHOTOBOX_THERMAL=1
# Nur bei 58mm/80mm: ESC/POS-Bondrucker direkt ansteuern (1 = ja). Die Photobox rastert den
# Streifen selbst in Druckkopf-Auflösung (Floyd-Steinberg) und schneidet ihn am Ende ab;
# CUPS reicht die Daten nur durch („raw“). Fotos werden so feiner und etwas größer.
#   PHOTOBOX_ESCPOS_DOTS: Druckkopfbreite in Punkten (Standard 576 bei 80 mm, 384 bei 58 mm)
#   PHOTOBOX_ESCPOS_FEED: zusätzlicher Vorschub vor dem Schnitt in Punkten (8 = 1 mm)
PHOTOBOX_ESCPOS=0
PHOTOBOX_THERMAL_GAMMA=0.6
PHOTOBOX_THERMAL_EQUALIZE=0.5

# Nur bei 10x15: 2 = zwei gleiche Streifen nebeneinander auf 10×15 cm (zum Auseinanderschneiden),
#               1 = ein einzelner Streifen (5×15 cm)
PHOTOBOX_STRIPS_PER_PAGE=2

# Ordner des PDF-Testdruckers (cups-pdf) für „Letzten Druck ansehen“ (durch : getrennt)
# PHOTOBOX_PDF_DIRS=~/PDF:/var/spool/cups-pdf/ANONYMOUS

# Maximale Anzahl Abzüge pro Druckauftrag
PHOTOBOX_MAX_COPIES=4

# Adresse/Port des Servers. 0.0.0.0 = auch im Heimnetz erreichbar (http://<pi-adresse>:8080),
# 127.0.0.1 = nur über Caddy (https://) auf demselben Pi
PHOTOBOX_HOST=0.0.0.0
PHOTOBOX_PORT=8080

# Speicherort der Fotos (Standard: ./photos)
#PHOTOBOX_PHOTO_DIR=/home/pi/photobox-fotos
