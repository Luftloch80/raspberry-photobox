# CUPS-Druckername (leer = Standarddrucker). Namen anzeigen mit: lpstat -p
PHOTOBOX_PRINTER=

# Zusätzliche CUPS-Optionen (durch Leerzeichen getrennt), z. B. für Canon Selphy 10x15:
#   PHOTOBOX_PRINT_OPTIONS=fit-to-page media=Postcard
PHOTOBOX_PRINT_OPTIONS=fit-to-page

# Fotostreifen: 2 = zwei gleiche Streifen nebeneinander auf 10×15 cm (zum Auseinanderschneiden),
#               1 = ein einzelner Streifen (5×15 cm)
PHOTOBOX_STRIPS_PER_PAGE=2

# Ordner des PDF-Testdruckers (cups-pdf) für „Letzten Druck ansehen“ (durch : getrennt)
# PHOTOBOX_PDF_DIRS=~/PDF:/var/spool/cups-pdf/ANONYMOUS

# Maximale Anzahl Abzüge pro Druckauftrag
PHOTOBOX_MAX_COPIES=4

# Adresse/Port des Servers. 0.0.0.0 = auch im Heimnetz erreichbar (http://<pi-adresse>:8080),
# 127.0.0.1 = nur über Caddy (https://) auf demselben Pi
PHOTOBOX_HOST=0.0.0.0
PHOTOBOX_PORT=8080

# Speicherort der Fotos (Standard: ./photos)
#PHOTOBOX_PHOTO_DIR=/home/pi/photobox-fotos
